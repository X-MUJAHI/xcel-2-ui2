<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#1f2937"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <ImageView
            android:id="@+id/dialog_app_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/dialog_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#9e9e9e"
                android:id="@+id/dialog_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/dialog_app_package"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/dialog_app_dir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#00e5ff"
        android:id="@+id/dialog_app_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_dialog_extract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXTRACT"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#2d3748"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_dialog_uninstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNINSTALL"
            android:backgroundTint="#ef4444"/>
    </LinearLayout>
</LinearLayout>
