<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#151a22"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back_arrow"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shell Terminal"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <EditText
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:gravity="start|top"
        android:id="@+id/et_commands"
        android:background="#0a0c10"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:hint="input shizuku commands here..."
        android:layout_weight="1"
        android:fontFamily="monospace"/>
    <TextView
        android:textColor="#00ff00"
        android:id="@+id/tv_output"
        android:background="#1f2937"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:text="Output will appear here..."
        android:layout_weight="1"
        android:fontFamily="monospace"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#374151"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#374151"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#374151"/>
        <ImageButton
            android:id="@+id/btn_run"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Run Script"
            android:backgroundTint="#00e5ff"/>
    </LinearLayout>
    <android.widget.Space
        android:layout_width="match_parent"
        android:layout_height="60dp"/>
</LinearLayout>
