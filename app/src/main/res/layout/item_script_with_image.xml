<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_script_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_cyber_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Script Image Preview -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/cyber_surface"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/iv_script_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_script_placeholder"
            android:contentDescription="Script Preview" />

        <!-- Overlay Badge for Script Number -->
        <TextView
            android:id="@+id/tv_script_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/badge_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="SCRIPT 1"
            android:textColor="@color/cyber_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Active Status Indicator -->
        <TextView
            android:id="@+id/tv_active_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/badge_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ACTIVE 🟢"
            android:textColor="@color/cyber_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

    <!-- Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_script_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Script 1"
                android:textColor="@color/cyber_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_script_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 Files Pair (Cloud verified)"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/cyber_cyan"
            android:paddingHorizontal="14dp"
            android:text="SELECT"
            android:textColor="#0B0E14"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
