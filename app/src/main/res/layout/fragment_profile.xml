<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USER PROFILE"
            android:textColor="@color/cyber_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:layout_marginBottom="24dp" />

        <!-- Key & Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_cyber_bg"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LICENSE &amp; ACTIVATION"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Key: Loading..."
                android:textColor="@color/cyber_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/stat_box_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_copy_current_key"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📋 COPY KEY"
                android:backgroundTint="@color/cyber_card_elevated"
                android:textColor="@color/cyber_cyan"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_change_key"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔄 CHANGE KEY"
                android:backgroundTint="@color/cyber_cyan"
                android:textColor="#0B0E14"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_logout_key"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🚪 LOGOUT / RESET KEY"
                android:backgroundTint="@color/cyber_card_elevated"
                android:textColor="@color/cyber_red"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Help Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_cyber_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEED A NEW KEY?"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact @x_celestials on Instagram or visit our Telegram channel to obtain an active key or request license renewal."
                android:textColor="@color/cyber_text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_profile_instagram"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CONTACT ON INSTAGRAM"
                android:backgroundTint="@color/cyber_surface"
                android:textColor="#F50057"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
