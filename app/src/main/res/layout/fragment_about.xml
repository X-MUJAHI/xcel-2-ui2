<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABOUT X-CELESTIALS"
            android:textColor="@color/cyber_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_cyber_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 INSTRUCTIONS &amp; GUIDELINES"
                android:textColor="@color/cyber_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Grant required permissions (Storage / Shizuku) for seamless system file management.\n\n2. Tap 'ACTIVATE FIRST TIME' on Home screen. The app will securely fetch and store all 4 cloud files.\n\n3. Tap 'TURN ON' or 'TURN OFF' to automatically stage the files into your dynamic target paths.\n\n4. If any path is empty, the optimizer automatically creates required directories and copies files cleanly."
                android:textColor="@color/cyber_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ GUILD RULES"
                android:textColor="@color/cyber_amber"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Be an active member: Contribute glory daily and push ranks with guild teammates.\n• Do not share panel files or keys without permission.\n• Show respect to guild members."
                android:textColor="@color/cyber_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
