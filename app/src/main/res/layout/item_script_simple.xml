<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_script_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="@drawable/card_cyber_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Script Icon / Lightning Indicator -->
    <TextView
        android:id="@+id/tv_script_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/stat_box_bg"
        android:gravity="center"
        android:text="⚡"
        android:textSize="18sp"
        android:layout_marginEnd="12dp" />

    <!-- Script Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_script_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Script 1"
                android:textColor="@color/cyber_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_active_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_pill_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="ACTIVE"
                android:textColor="@color/cyber_green"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_script_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2 Files Pair"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_action"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/cyber_cyan"
        android:paddingHorizontal="14dp"
        android:text="TURN ON"
        android:textColor="#0B0E14"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
