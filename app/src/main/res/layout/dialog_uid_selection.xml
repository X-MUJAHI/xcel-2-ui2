<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/glass_bg"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Anti-Ban Verification"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#aaaaaa"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Select an active UID to apply anti-ban protections before launching."/>
        <ListView
            android:id="@+id/list_uids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#444444"
            android:dividerHeight="1dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_loading_uids"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#00e5ff"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff5252"
            android:gravity="center"
            android:id="@+id/tv_no_uids"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="No UIDs found. Please play the game once normally to generate a UID folder."/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_cancel_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CANCEL"
            android:backgroundTint="#2d3748"/>
    </LinearLayout>
</FrameLayout>
