<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_floating_timer_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/badge_pill_bg"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡"
        android:textSize="12sp"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tv_floating_timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/cyber_cyan"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <ImageView
        android:id="@+id/iv_floating_timer_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:padding="2dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close floating timer"
        app:tint="@color/cyber_text_muted" />

</LinearLayout>
