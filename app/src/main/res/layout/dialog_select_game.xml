<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_bg"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Select Game to Open"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Choose your game version to apply protections and launch:"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="22dp" />

        <!-- Free Fire MAX -->
        <Button
            android:id="@+id/btn_game_ff_max"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎮 FREE FIRE MAX"
            android:backgroundTint="#00E5FF"
            android:textColor="#151A22"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- Free Fire TH -->
        <Button
            android:id="@+id/btn_game_ff_th"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔥 FREE FIRE"
            android:backgroundTint="#FFB300"
            android:textColor="#151A22"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_cancel_game_select"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:backgroundTint="#2D3748"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</FrameLayout>
