<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#151a22"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back_arrow"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="WiFi Manager"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <ImageView
            android:id="@+id/btn_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#00e5ff"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/tv_wifi_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Checking WiFi Status..."
            android:layout_weight="1"/>
        <Switch
            android:id="@+id/switch_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <HorizontalScrollView
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textColor="#00e5ff"
                android:id="@+id/btn_current_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Network"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#263238"/>
            <Button
                android:textColor="#00e5ff"
                android:id="@+id/btn_open_ports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Ports"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#263238"/>
            <Button
                android:textColor="#00e5ff"
                android:id="@+id/btn_net_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Net Stats"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#263238"/>
            <Button
                android:textColor="#00e5ff"
                android:id="@+id/btn_conn_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connectivity"
                android:backgroundTint="#263238"/>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00e5ff"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved WiFi Passwords"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_wifi"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
